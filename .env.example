# Konfigurasi Gemini API
GEMINI_API_KEY=

# Konfigurasi Folder
FOLDER_TUGAS=./foto_tugas
FOLDER_REFERENSI=./referensi
FOLDER_PROMPTS=./prompts

# Konfigurasi Output & Pemrosesan
OUTPUT_EXCEL=rekap_nilai.xlsx
SISWA_PER_BATCH=6

# Konfigurasi Opsi Interaktif (Opsional: biarkan kosong untuk konfirmasi manual via CMD)
# GUNAKAN_REFERENSI=true     # 'true' (dengan referensi) atau 'false' (tanpa referensi)
# FORMAT_LEMBAR_JAWAB=file   # 'file' (per file) atau 'folder' (per folder Kelas/Nama)
